# mhr-etl — scrapes myhockeyrankings.com into Supabase
#
# Copy to `.env` and fill in. In CI these come from GitHub repo secrets of the
# same names (see .github/workflows/mhr-rankings.yml and mhr-leagues.yml).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key. Required: the p_batch_* stored procedures write to
# rankings/associations/leagues and are not reachable with the publishable key.
# Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Overrides which Chrome binary Puppeteer launches. Leave unset to use
# Puppeteer's own bundled Chrome-for-Testing, which is the expected setup both
# locally and in CI.
# PUPPETEER_EXECUTABLE_PATH=
