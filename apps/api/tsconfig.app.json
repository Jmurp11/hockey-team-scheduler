{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "../../dist/apps/api",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    // Deliberately no `baseUrl` override here. It used to be `"./"`, which
    // repointed the `paths` in tsconfig.base.json at apps/api so they resolved
    // to nothing — that is why this app had never imported a shared library.
    // Inheriting the workspace baseUrl lets `@hockey-team-scheduler/*` resolve,
    // and lets Nx remap it to the built output for buildable libraries.
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "importHelpers": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts"]
}